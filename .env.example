# Databricks Workspace Configuration
DATABRICKS_HOST=https://your-workspace.databricks.com
DATABRICKS_TOKEN=dapi1234567890abcdef

# Unity Catalog Configuration
UC_CATALOG=lakehouse_healing
BRONZE_SCHEMA=bronze
SILVER_SCHEMA=silver
GOLD_SCHEMA=gold
OPS_SCHEMA=ops

# Volume Paths
LANDING_VOLUME=/Volumes/lakehouse_healing/ops/landing
CHECKPOINT_VOLUME=/Volumes/lakehouse_healing/ops/checkpoints

# Cluster Configuration
DATABRICKS_CLUSTER_ID=cluster-123456
DBR_VERSION=13.3

# AI Healing Configuration
FOUNDATION_MODEL_ENDPOINT=databricks-llama-3-3-70b-instruct
HEALING_CONFIDENCE_THRESHOLD=0.75

# Processing Configuration
BATCH_SIZE=1000
MAX_RETRIES=3
RETRY_DELAY_SECONDS=300
TIMEOUT_MINUTES=60

# Environment
ENVIRONMENT=development
